# PostgreSQL is required in every environment. No database URL means startup fails.
# For a private local database, run: .venv/bin/python tools/local_postgres.py
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ENVIRONMENT=development
SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:5174
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Only these email addresses receive administrator permissions. Empty = nobody.
ADMIN_EMAILS=
# mock gives explicitly labeled offline concept notes. Gemini requires a private key.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10
# Tests must use a dedicated local database named pragyax_test, never Supabase.
# TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:55433/pragyax_test?sslmode=disable
# Frontend variables belong in frontend/.env.local or the build environment.
# VITE_BACKEND_URL=http://127.0.0.1:8011
# VITE_API_URL=https://your-backend.example
